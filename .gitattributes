# Normalisasi line ending otomatis
* text=auto

# Go source files — LF
*.go text eol=lf

# Web source files — LF
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.env.example text eol=lf

# Binary files — jangan diubah
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
